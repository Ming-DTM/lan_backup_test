# 要备份的源文件夹（多个用逗号分隔，路径用/或\\，示例：D:/工作文档,E:/项目资料）
SOURCE_FOLDERS = "D:/project/DVB-T2/MP EOL"

# 备份类型：local_lan（网线连接的本地硬盘/NAS）、smb_server（局域网SMB服务器）
BACKUP_TYPE = "local_lan"

# 【local_lan类型必改】网线连接的硬盘/NAS路径（如映射的Z盘、NAS路径：Z:/backup）
# LOCAL_LAN_PATH = "//192.168.0.200/Home/User18/嘉硕"

# 【smb_server类型必改】局域网服务器信息（网线连接的IP）
# SMB_SERVER_IP = "192.168.0.200"  # 你的服务器/硬盘IP（网线连接）
# SMB_USERNAME = "NA"          # 服务器登录账号
# SMB_PASSWORD = "NA"         # 服务器登录密码
# SMB_SHARE_NAME = "backup_share" # 服务器共享文件夹名称

# ===================== 通用配置（可选改） =====================
# SMB_SERVER_PORT = 139           # SMB默认端口，无需改
# PING_RETRY = 5                  # 网络检查重试次数
# PING_INTERVAL = 10              # 重试间隔（秒）
# LOG_FILE = "lan_backup_log.txt" # 日志文件路径（自动生成）